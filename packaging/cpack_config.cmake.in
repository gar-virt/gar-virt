set(PROJECT_SCM_VERSION_FILE "@PROJECT_SCM_VERSION_FILE@")
set(PROJECT_VERSION "@PROJECT_VERSION@")
set(PROJECT_NAME "@PROJECT_NAME@")
set(CMAKE_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@")
set(CMAKE_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@")

file(READ "${PROJECT_SCM_VERSION_FILE}" PROJECT_SCM_VERSION)
string(STRIP "${PROJECT_SCM_VERSION}" PROJECT_SCM_VERSION)
string(SUBSTRING "${PROJECT_SCM_VERSION}" 0 7 PROJECT_SCM_VERSION_SHORT)

set(FILE_NAME_VERSION "${PROJECT_VERSION}")
if(GARVIRT_NIGHTLY)
    set(FILE_NAME_VERSION "${PROJECT_VERSION}-nightly-g${PROJECT_SCM_VERSION_SHORT}")
endif()

set(CPACK_PACKAGE_FILE_NAME "${PROJECT_NAME}-${FILE_NAME_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
string(TOLOWER "${CPACK_PACKAGE_FILE_NAME}" CPACK_PACKAGE_FILE_NAME)

set(DEB_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
if(DEB_ARCH STREQUAL "x86_64")
    set(DEB_ARCH "amd64")
endif()

set(CPACK_DEBIAN_FILE_NAME "${PROJECT_NAME}_${FILE_NAME_VERSION}_${DEB_ARCH}")
string(REPLACE "-" "_" CPACK_DEBIAN_FILE_NAME "${CPACK_DEBIAN_FILE_NAME}")
